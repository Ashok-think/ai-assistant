# Jarvish — environment
# Copy to .env.local (git-ignored). EVERY key is optional: with none set the app still runs
# on the built-in offline persona engine + browser speech synthesis.
# Keys can also be pasted at runtime in Settings → they are stored in the local SQLite DB.

# ---------- LLM providers (first one that has a key wins, cheapest tier first) ----------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides for the OpenAI provider
# FAST_MODEL=gpt-4o-mini
# SMART_MODEL=gpt-4o

# ---------- OpenAI-compatible BYOK endpoints (key + base URL + model id) ----------
TOKENROUTER_API_KEY=
# TOKENROUTER_BASE_URL=https://api.tokenrouter.io/v1
# TOKENROUTER_MODEL=gpt-4o-mini

QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

AIHUB_API_KEY=
# AIHUB_BASE_URL=https://aihubmix.com/v1
# AIHUB_MODEL=gpt-4o-mini

CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=https://openrouter.ai/api/v1
# CUSTOM_LLM_MODEL=gpt-4o-mini

# ---------- Local models (no key, no cost) ----------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ---------- Voice ----------
# Gemini TTS is used first (free tier) with the GEMINI_API_KEY above.
# ElevenLabs is the premium fallback; each character already has a default voice id.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ---------- Tools ----------
# Weather and web search use free keyless APIs (Open-Meteo / DuckDuckGo) by default.

# ---- Talking Character (remote GPU AI video lip-sync) ----
# See docs/talking-character-backend.md for the backend contract.
TALKING_CHARACTER_PROVIDER=remote
REMOTE_LIPSYNC_URL=
REMOTE_LIPSYNC_API_KEY=
# Absolute origin so the backend can fetch source clips (defaults to http://localhost:3000)
NEXT_PUBLIC_BASE_URL=
